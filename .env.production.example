# Configure these in the deployment environment; never commit real values.
ENVIRONMENT=production
MONGO_URL=mongodb+srv://USER:PASSWORD@CLUSTER/admin_production
DB_NAME=admin_production
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
FRONTEND_URL=https://admin.example.com
POS_CORE_API_BASE_URL=https://pos.example.com
# The POS service's ADMINCORE_API_KEY must have exactly the same secret.
POS_CORE_API_KEY=REPLACE_WITH_A_RANDOM_BRIDGE_SECRET_AT_LEAST_32_CHARACTERS
# Retain previous bridge keys here during rotation while their privacy markers exist.
# Comma-separated; these keys verify historical erasure digests and never authenticate API calls.
POS_PRIVACY_PREVIOUS_KEYS=
# Browser-independent reconciliation. Failed jobs retain their retry history.
POS_RECONCILE_INTERVAL_SECONDS=600
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
SEED_DEMO_DATA=false
# Initial administrator only. Use a strong private password.
ADMIN_EMAIL=operator@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PRIVATE_PASSWORD
