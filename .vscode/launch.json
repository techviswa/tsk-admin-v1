{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Open AdminCore",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/dev.mjs",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "env": { "BROWSER": "none" },
      "serverReadyAction": {
        "pattern": "AdminCore ready: (http://localhost:3001)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
