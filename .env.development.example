# Copy to .env.development.local (ignored by git). Use a separate local database.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=admincore_local
# Optional external POS bridge; the AdminCore launcher does not start POS.
POS_CORE_API_BASE_URL=http://127.0.0.1:4001
POS_CORE_API_KEY=replace-with-a-local-bridge-key
JWT_SECRET=replace-with-a-stable-local-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=replace-with-a-local-password-at-least-12-characters
